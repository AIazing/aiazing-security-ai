{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIazing Assessment Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "authorization_ref", "environment", "mode", "scope", "limits", "export_formats"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entry_url"],
      "properties": {
        "type": {"enum": ["web_application", "http_api"]},
        "entry_url": {"type": "string", "format": "uri", "pattern": "^https?://"}
      }
    },
    "authorization_ref": {"type": "string", "minLength": 1},
    "environment": {"enum": ["public", "isolated_lab"]},
    "mode": {"enum": ["public", "account_based"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_origins", "excluded_path_prefixes"],
      "properties": {
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri", "pattern": "^https?://[^/?#@]+$"}
        },
        "excluded_path_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_requests", "max_requests_per_second", "max_duration_seconds", "max_model_tokens"],
      "properties": {
        "max_requests": {"type": "integer", "minimum": 1},
        "max_requests_per_second": {"type": "number", "exclusiveMinimum": 0},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_model_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "application_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "expected_permissions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "test_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_id", "role", "credential_ref"],
        "properties": {
          "account_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "credential_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "export_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "json"}}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "account_based"}}},
      "then": {"required": ["test_accounts"], "properties": {"test_accounts": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"mode": {"const": "public"}}},
      "then": {"properties": {"test_accounts": {"maxItems": 0}}}
    }
  ]
}
